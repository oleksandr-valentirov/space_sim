# C build artefacts (Makefile, M0)
/build/

# Rust
/target/
**/target/

# Cooked assets -- produced by the cooker, not kept in git (PROJECT.md section 3)
/assets/

# Ephemeris and other generated data
*.eph

# Raw content sources -- on disk, not in git (answer to Q5, 2026-08-16).
# The line is drawn by role, not by size: git keeps whatever is an input to a
# check. So the WAC mosaic (66 MB) stays out while its *label* stays in -- the
# reader test stands on it. Provenance and SHA-256: data/wac/README.md.
/data/wac/*.img

# Earth, same rule (T7a): git holds the ETOPO label, the whole TIFF header our
# GeoTIFF reader is tested against. The BMNG mosaic deliberately has no label:
# a third-party crate parses the JPEG, and that header is no check's input.
# Provenance and SHA-256: data/etopo/README.md and data/bmng/README.md.
/data/etopo/*.tif
/data/bmng/*.jpg

# The star catalogue, same rule again (stage Z, Z2). Here git keeps **only**
# the README: unlike WAC and ETOPO, nothing in this directory is the input to a
# check -- the cooker's oracle carries three real catalogue lines as constants
# in the test itself. Provenance and SHA-256: data/bsc5/README.md.
/data/bsc5/catalog
/data/bsc5/catalog.gz
/data/bsc5/ReadMe

# ...except the fixture asset. It is DELIBERATELY in git: the cross-platform
# hash comparison (ROADMAP C5) must compare the runtime, not the cooker. The
# cooker uses cos() in its Chebyshev fit, so another machine would produce
# different coefficients and the check would fail in the wrong place. Cook it
# once -- `make cook`.
!/data/fixture/*.eph

# Badge JSON written by scripts/badge_json.sh. It is generated on every push to
# main and lives in the `badges` branch, which shares no commit with this one;
# a copy on main would be a second answer to the same question, aging.
/badges/

# Python: scripts/ are helper utilities, no bytecode kept
__pycache__/
*.pyc

# Virtualenv for matplotlib -- the path scripts/requirements.txt describes.
# Needed only for make plots; the core does not depend on it and CI lacks it.
/.venv/

# Editors, OS
.vscode/
.idea/
*.swp
.DS_Store

# The Slang compiler -- 24 MB of binaries, updated monthly.
# Installed by scripts/fetch_slang.sh (ROADMAP P1).
/tools/slang/
engine/build/

# Blender backup: it writes this itself on every save.
assets-src/*.blend1
