# Артефакти збірки C (Makefile, M0)
/build/

# Rust
/target/
**/target/

# Скуковані ассети — генеруються кукером, у git не тримаємо (PROJECT.md §3)
/assets/

# Ефемерида та інші згенеровані дані
*.eph

# ...крім ассета-фікстури. Він НАВМИСНО в git: крос-платформна звірка хешів
# (ROADMAP C5) має порівнювати рантайм, а не кукер. Кукер використовує cos()
# у чебишевській підгонці, тож на іншій машині коефіцієнти вийшли б інші
# й перевірка падала б не там, де треба. Готуємо один раз — `make cook`.
!/data/fixture/*.eph

# Python: scripts/ — допоміжні утиліти, байткод не тримаємо
__pycache__/
*.pyc

# Віртуальне середовище для matplotlib — шлях, який описує
# scripts/requirements.txt. Потрібне лише для make plots; ядро від нього
# не залежить, на CI його немає.
/.venv/

